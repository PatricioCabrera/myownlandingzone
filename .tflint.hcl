# terraform validate checks that the code is consistent with itself. TFLint adds
# what validate cannot know: provider-specific values (an instance type that does
# not exist) and conventions (unused declarations, missing types and descriptions).
plugin "terraform" {
  enabled = true
  preset  = "recommended"
}

plugin "aws" {
  enabled = true
  version = "0.50.0"
  source  = "github.com/terraform-linters/tflint-ruleset-aws"
}

rule "terraform_documented_variables" {
  enabled = true
}

rule "terraform_documented_outputs" {
  enabled = true
}

rule "terraform_naming_convention" {
  enabled = true
}
